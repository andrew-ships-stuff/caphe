---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Activity, Timer, MemoryStick, Cpu, ShieldCheck, CircleDashed, ArrowRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const metrics = [
  { icon: Timer, name: 'CPU-seconds', state: 'framework', text: 'Measure process CPU time for scanner, correlation, inference, and verification stages separately.' },
  { icon: MemoryStick, name: 'Peak RSS', state: 'framework', text: 'Record peak resident memory with model, context, concurrency, and scanner versions.' },
  { icon: Cpu, name: 'Inference latency', state: 'not_run', text: 'Tokens per second and wall time require a pinned model, digest, runtime, prompt, and CPU.' },
  { icon: ShieldCheck, name: 'Security quality', state: 'not_run', text: 'Precision, recall, false positives, and verified discoveries require labeled positive and clean-negative corpora.' }
];
---
<BaseLayout title="Benchmarking — Caphe" description="Caphe's honest benchmarking framework, current deterministic fixture harness, and planned security-quality experiments.">
  <article class="page-shell">
    <header class="page-hero"><span>Technical report / current snapshot</span><h1>Benchmarking without invented numbers.</h1><p>Caphe ships a reproducibility smoke test. It does not yet ship defensible scanner, inference, correlation, or security-accuracy results.</p></header>
    <section class="notice"><Activity/><div><strong>Available now</strong><p><code>caphe benchmark run</code> repeats normalization of one embedded synthetic Opengrep observation and verifies byte-for-byte reproducibility. That is a harness check, not a product benchmark.</p></div></section>
    <section><div class="heading"><span>Measurement matrix</span><h2>Every empty result stays visibly empty.</h2></div><div class="metrics">{metrics.map(({ icon: Icon, name, state, text }) => <article><Icon/><div class:list={['badge', state]}>{state === 'not_run' ? 'Not run' : 'Framework defined'}</div><h3>{name}</h3><p>{text}</p></article>)}</div></section>
    <section class="method"><div class="heading"><span>Methodology</span><h2>A benchmark must be reproducible, attributable, and falsifiable.</h2></div><div class="method-grid"><div><b>01</b><h3>Freeze inputs</h3><p>Pin the Caphe commit, workflow lock, scanner versions and databases, model digest, llama.cpp build, prompts, schema, target revision, and operating-system image.</p></div><div><b>02</b><h3>Separate baselines</h3><p>Compare scanner-only normalization, deterministic graph correlation, bounded CPU inference, and inference followed by independent verification.</p></div><div><b>03</b><h3>Use negatives</h3><p>Keep vulnerable and clean-negative fixtures, and separate prompt-development examples from final evaluation data.</p></div><div><b>04</b><h3>Report uncertainty</h3><p>Publish repetitions, dispersion, failures, inconclusive hypotheses, provenance completeness, and hardware—not only a favorable mean.</p></div></div></section>
    <section class="metrics-table"><div class="heading"><span>Planned outputs</span><h2>What the complete harness will record.</h2></div><div class="scroll"><table><thead><tr><th>Dimension</th><th>Metrics</th><th>Required context</th></tr></thead><tbody><tr><td>Resources</td><td>CPU-seconds, peak RSS, wall time</td><td>CPU, OS, limits, concurrency</td></tr><tr><td>Inference</td><td>Latency, tokens/s, schema-validity, cache hits</td><td>Model/runtime digest, context, prompt/schema versions</td></tr><tr><td>Security</td><td>Precision, recall, FP/FN, inconclusive hypotheses</td><td>Labeled corpus and independent adjudication</td></tr><tr><td>Utility</td><td>Additional verified findings per CPU-hour</td><td>Scanner-only and deterministic baselines</td></tr><tr><td>Reproducibility</td><td>Byte equality, provenance completeness</td><td>Frozen inputs and repeated runs</td></tr></tbody></table></div></section>
    <section class="falsifiable"><CircleDashed/><div><span>The question</span><h2>Does bounded small-model inference add independently verified security relationships over deterministic correlation at acceptable CPU cost?</h2><p>Until the data answers that question, the site will not imply that it does.</p><a href={href('/docs/cpu-inference/')}>Read the inference contract <ArrowRight size={16}/></a></div></section>
  </article>
</BaseLayout>
<style>
  .page-shell { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; }.page-hero { max-width: 850px; padding: 7rem 0 5rem; }.page-hero span, .heading span, .falsifiable span { color: var(--caphe-accent); font: 700 .72rem ui-monospace, monospace; letter-spacing: .11em; text-transform: uppercase; }.page-hero h1 { margin: .9rem 0; font-size: clamp(2.8rem, 7vw, 5.7rem); line-height: .98; letter-spacing: -.06em; }.page-hero p { color: var(--caphe-muted); font-size: 1.15rem; line-height: 1.7; }.notice { display: grid; grid-template-columns: auto 1fr; gap: 1rem; border: 1px solid var(--caphe-teal); border-radius: 1rem; background: color-mix(in srgb, var(--caphe-teal), transparent 93%); padding: 1.3rem; }.notice :global(svg) { color: var(--caphe-teal); }.notice p { color: var(--caphe-muted); }.notice code { color: var(--caphe-text); }.page-shell section { margin-bottom: 7rem; }.heading { max-width: 720px; margin-bottom: 2rem; }.heading h2, .falsifiable h2 { margin: .6rem 0; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; letter-spacing: -.04em; }.metrics, .method-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }.metrics article, .method-grid > div { border: 1px solid var(--caphe-border); border-radius: .8rem; background: var(--caphe-surface); padding: 1.25rem; }.metrics :global(svg) { color: var(--caphe-accent); }.metrics h3, .method-grid h3 { margin-top: 2rem; }.metrics p, .method-grid p { color: var(--caphe-muted); font-size: .85rem; line-height: 1.65; }.badge { width: fit-content; margin-top: 1rem; border: 1px solid var(--caphe-border); border-radius: 999px; color: var(--caphe-muted); padding: .25rem .5rem; font: .6rem ui-monospace, monospace; text-transform: uppercase; }.badge.framework { color: var(--caphe-teal); }.method-grid b { color: var(--caphe-accent); font: .7rem ui-monospace, monospace; }.scroll { overflow-x: auto; }.metrics-table table { width: 100%; border-collapse: collapse; min-width: 700px; }.metrics-table th, .metrics-table td { border-bottom: 1px solid var(--caphe-border); padding: 1rem; text-align: left; }.metrics-table th { color: var(--caphe-muted); font-size: .72rem; text-transform: uppercase; }.metrics-table td { color: var(--caphe-muted); }.metrics-table td:first-child { color: var(--caphe-text); font-weight: 700; }.falsifiable { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; border-top: 1px solid var(--caphe-border); padding-top: 4rem; }.falsifiable > :global(svg) { color: var(--caphe-accent); }.falsifiable p { color: var(--caphe-muted); }.falsifiable a { display: flex; align-items: center; gap: .4rem; color: var(--caphe-accent); text-decoration: none; font-weight: 700; } @media(max-width:850px){.metrics,.method-grid{grid-template-columns:1fr 1fr}} @media(max-width:520px){.metrics,.method-grid{grid-template-columns:1fr}.page-hero{padding-top:4rem}}
</style>
