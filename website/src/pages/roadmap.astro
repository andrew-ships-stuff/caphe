---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Check, LoaderCircle, CalendarClock } from '@lucide/astro';
const phases = [
  { n: '01', title: 'Deterministic CLI and scanner orchestration', status: 'available', detail: 'Go CLI, local SQLite/artifacts, fixed DAG execution, Opengrep, Syft, Grype, Gitleaks, and JSON/SARIF/HTML reports.' },
  { n: '02', title: 'Workflow compilation', status: 'available', detail: 'Typed v1alpha1 YAML, security/syntax gates, canonical lock ordering, adapter pinning, bounded retries and timeouts, and SHA-256 validation.' },
  { n: '03', title: 'Unified evidence graph', status: 'in-progress', detail: 'Evidence types, statuses, provenance, scanner observations, and exact source references exist. Package/image/workload/RBAC correlation is next.' },
  { n: '04', title: 'CPU-native semantic inference', status: 'in-progress', detail: 'Hardware inspection, unvalidated recommendations, loopback llama.cpp provider, strict schema, caching, and hypothesis storage exist. Managed provisioning does not.' },
  { n: '05', title: 'Invariant discovery and verification', status: 'planned', detail: 'Expand independent strategies, verification state transitions, positive/negative authorization fixtures, and richer accuracy evaluation.' },
  { n: '06', title: 'Compiled reusable security knowledge', status: 'planned', detail: 'Turn reviewed, verified relationships into reusable checks only after validation and approval controls exist.' },
  { n: '07', title: 'Distributed Kubernetes workers', status: 'planned', detail: 'Capability-aware scheduling, leases, idempotency, worker/control-plane binaries, operational transport decisions, and Helm packaging.' }
];
---
<BaseLayout title="Roadmap — Caphe" description="The source-derived Caphe roadmap, clearly separating available foundations, active work, and planned architecture.">
  <article class="roadmap"><header><span>Source-derived status / no percentages</span><h1>Build the deterministic core. Earn the intelligent layers.</h1><p>The roadmap tracks verifiable implementation boundaries. “In progress” means some foundation exists in source; it does not imply production readiness.</p><div class="legend"><b class="available">Available foundation</b><b class="in-progress">In progress</b><b class="planned">Planned</b></div></header>
    <div class="timeline">{phases.map((phase) => <section class={phase.status}><div class="rail"><span>{phase.n}</span></div><div class="card"><div class="status">{phase.status === 'available' ? <Check/> : phase.status === 'in-progress' ? <LoaderCircle/> : <CalendarClock/>}{phase.status.replace('-', ' ')}</div><h2>{phase.title}</h2><p>{phase.detail}</p></div></section>)}</div>
    <aside><strong>Near-term engineering queue</strong><p>Checkpoint/resume, typed task I/O and reference checking, richer graph correlation, verification transitions, cache commands, checksum-pinned inference provisioning, benchmark expansion, OS sandbox controls, import/export, additional adapters, and pinned real-scanner CI.</p></aside>
  </article>
</BaseLayout>
<style>
  .roadmap { width: min(960px, calc(100% - 2rem)); margin: 0 auto; padding: 7rem 0; }.roadmap > header { max-width: 780px; margin-bottom: 5rem; }.roadmap header > span { color: var(--caphe-accent); font: 700 .72rem ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }.roadmap h1 { margin: 1rem 0; font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: .98; letter-spacing: -.06em; }.roadmap header p { color: var(--caphe-muted); font-size: 1.1rem; line-height: 1.7; }.legend { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }.legend b, .status { border: 1px solid var(--caphe-border); border-radius: 999px; padding: .35rem .6rem; font: 650 .64rem ui-monospace, monospace; text-transform: uppercase; }.legend .available { color: var(--caphe-teal); }.legend .in-progress { color: var(--caphe-accent); }.legend .planned { color: var(--caphe-muted); }.timeline section { display: grid; grid-template-columns: 5rem 1fr; }.rail { position: relative; border-right: 1px solid var(--caphe-border); }.rail span { position: absolute; top: 1.4rem; right: -1.2rem; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border: 1px solid var(--caphe-border); border-radius: 50%; background: var(--caphe-bg); color: var(--caphe-muted); font: .7rem ui-monospace, monospace; }.card { margin: 0 0 1rem 3rem; border: 1px solid var(--caphe-border); border-radius: .9rem; background: var(--caphe-surface); padding: 1.4rem; }.card h2 { margin: .8rem 0 .4rem; font-size: 1.25rem; }.card p { color: var(--caphe-muted); line-height: 1.65; }.status { display: flex; align-items: center; gap: .35rem; width: fit-content; }.status :global(svg) { width: .8rem; height: .8rem; }.available .status { color: var(--caphe-teal); }.in-progress .status { color: var(--caphe-accent); }.planned .status { color: var(--caphe-muted); }.roadmap aside { margin-top: 4rem; border-left: 3px solid var(--caphe-accent); background: var(--caphe-surface); padding: 1.3rem; }.roadmap aside p { color: var(--caphe-muted); line-height: 1.7; } @media(max-width:600px){.roadmap{padding-top:4rem}.timeline section{grid-template-columns:2rem 1fr}.rail span{right:-.9rem;width:1.8rem;height:1.8rem}.card{margin-left:1.5rem}}
</style>
