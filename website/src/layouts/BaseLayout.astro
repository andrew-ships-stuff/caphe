---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Caphe',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description,
  url: canonical.href,
  codeRepository: 'https://github.com/andrew-ships-stuff/caphe',
  license: 'https://opensource.org/license/mit'
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0c1014" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Caphe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('/og-image.png'), Astro.site ?? Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('caphe-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navigation />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>

<style>
  .skip-link { position: fixed; z-index: 100; top: .75rem; left: .75rem; transform: translateY(-200%); border-radius: .5rem; background: var(--caphe-accent); color: #111; padding: .75rem 1rem; font-weight: 750; }
  .skip-link:focus { transform: translateY(0); }
</style>
