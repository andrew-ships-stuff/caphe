---
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<footer>
  <div class="footer-grid">
    <div>
      <a class="wordmark" href={href('/')}>caphe<span>_</span></a>
      <p>Compile intelligence. Execute deterministically. Verify everything.</p>
      <small>Open source under the MIT License.</small>
    </div>
    <div><strong>Learn</strong><a href={href('/docs/getting-started/')}>Documentation</a><a href={href('/docs/architecture/')}>Architecture</a><a href={href('/docs/security/')}>Security model</a></div>
    <div><strong>Project</strong><a href={href('/roadmap/')}>Roadmap</a><a href={href('/contributing/')}>Contributing</a><a href="https://github.com/andrew-ships-stuff/caphe/issues">Issues</a></div>
    <div><strong>GitHub</strong><a href="https://github.com/andrew-ships-stuff/caphe">Source</a><a href="https://github.com/andrew-ships-stuff/caphe/releases">Releases</a><a href="https://github.com/andrew-ships-stuff/caphe/blob/main/LICENSE">License</a></div>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--caphe-border); background: var(--caphe-surface); padding: 4rem 1rem; }
  .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 3rem; width: min(1120px, 100%); margin: 0 auto; }
  .footer-grid > div { display: grid; align-content: start; gap: .7rem; }
  .wordmark { color: var(--caphe-text); font: 800 1.3rem ui-monospace, monospace; text-decoration: none; }
  .wordmark span { color: var(--caphe-accent); }
  p, small, a { color: var(--caphe-muted); }
  p { max-width: 34rem; margin: .2rem 0; }
  strong { color: var(--caphe-text); font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; }
  .footer-grid a:not(.wordmark) { width: fit-content; text-decoration: none; font-size: .9rem; }
  .footer-grid a:hover { color: var(--caphe-accent); }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-grid > div:first-child { grid-column: 1 / -1; } }
</style>
