---
import { Terminal, FileCheck, Network, ScanSearch, Database, BrainCircuit, BadgeCheck, FileOutput } from '@lucide/astro';
const scanners = ['Opengrep', 'Syft', 'Grype', 'Gitleaks'];
---
<div class="architecture" aria-label="Caphe architecture from CLI through verified output">
  <div class="main-flow">
    <div class="node"><Terminal/><span>Caphe CLI</span><small>workflow input</small></div><i aria-hidden="true"></i>
    <div class="node deterministic"><FileCheck/><span>Workflow compiler</span><small>validated lock + digest</small></div><i aria-hidden="true"></i>
    <div class="node deterministic"><Network/><span>Execution DAG</span><small>fixed dependencies</small></div>
  </div>
  <div class="scanner-row" aria-label="Implemented scanners">{scanners.map((name) => <span><ScanSearch size={15}/>{name}</span>)}</div>
  <div class="down" aria-hidden="true"></div>
  <div class="node graph"><Database/><span>Evidence graph</span><small>observations + provenance</small></div>
  <div class="branches">
    <div class="node deterministic"><Network/><span>Deterministic correlation</span><small>implemented foundation</small></div>
    <div class="node probabilistic"><BrainCircuit/><span>CPU-only hypotheses</span><small>optional · bounded · experimental</small></div>
  </div>
  <div class="merge" aria-hidden="true"></div>
  <div class="main-flow bottom">
    <div class="node planned"><BadgeCheck/><span>Verification engine</span><small>partial foundation · roadmap</small></div><i aria-hidden="true"></i>
    <div class="node"><FileOutput/><span>Security output</span><small>JSON · SARIF · HTML</small></div>
  </div>
  <div class="legend"><span><b class="det"></b>Deterministic</span><span><b class="prob"></b>Probabilistic, bounded</span><span><b class="plan"></b>Planned boundary</span></div>
</div>
<style>
  .architecture { width: min(940px, 100%); margin: 0 auto; border: 1px solid var(--caphe-border); border-radius: 1.25rem; background: color-mix(in srgb, var(--caphe-surface), transparent 8%); padding: clamp(1rem, 3vw, 2rem); }
  .main-flow, .branches { display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
  .node { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .15rem .6rem; min-width: 12rem; border: 1px solid var(--caphe-border); border-radius: .8rem; background: var(--caphe-bg); padding: .9rem 1rem; }
  .node :global(svg) { grid-row: 1 / 3; color: var(--caphe-accent); width: 1.25rem; }
  .node span { color: var(--caphe-text); font-size: .82rem; font-weight: 750; }
  .node small { color: var(--caphe-muted); font-size: .65rem; }
  .node.deterministic { border-left: 3px solid var(--caphe-teal); }
  .node.probabilistic { border-left: 3px dashed var(--caphe-accent); }
  .node.planned { border-style: dashed; border-left: 3px dashed #9ea9ae; }
  .main-flow i { width: 2.5rem; height: 1px; background: var(--caphe-border); }
  .main-flow i::after { content: ''; display: block; float: right; border: 4px solid transparent; border-left-color: var(--caphe-border); transform: translate(7px, -3px); }
  .scanner-row { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin: 1.5rem auto 0; }
  .scanner-row span { display: flex; align-items: center; gap: .4rem; border: 1px solid var(--caphe-border); border-radius: 999px; color: var(--caphe-muted); padding: .4rem .7rem; font: .68rem ui-monospace, monospace; }
  .down { width: 1px; height: 1.4rem; margin: 0 auto; background: var(--caphe-border); }
  .graph { width: fit-content; margin: 0 auto; border-color: var(--caphe-accent); }
  .branches { align-items: stretch; margin-top: 1.5rem; }
  .branches::before, .branches::after { content: ''; width: 2rem; align-self: start; border-top: 1px solid var(--caphe-border); }
  .merge { width: 48%; height: 1.5rem; margin: 0 auto; border-right: 1px solid var(--caphe-border); border-bottom: 1px solid var(--caphe-border); border-left: 1px solid var(--caphe-border); }
  .bottom { margin-top: 1.5rem; }
  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.1rem; margin-top: 1.7rem; color: var(--caphe-muted); font-size: .65rem; }
  .legend span { display: flex; align-items: center; gap: .4rem; }
  .legend b { width: 1.2rem; border-top: 3px solid var(--caphe-teal); }.legend .prob { border-top: 3px dashed var(--caphe-accent); }.legend .plan { border-top: 2px dashed #9ea9ae; }
  @media (max-width: 760px) { .main-flow, .branches { flex-direction: column; } .main-flow i { width: 1px; height: 1.4rem; } .main-flow i::after { float: none; border-left-color: transparent; border-top-color: var(--caphe-border); transform: translate(-3px, 17px); } .node { width: min(100%, 22rem); } .branches::before, .branches::after, .merge { display: none; } .bottom { margin-top: 1.5rem; } }
</style>
