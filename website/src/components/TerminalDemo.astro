---
import { Copy, Check, SquareTerminal } from '@lucide/astro';
const demos = [
  { id: 'audit', label: 'Audit', command: 'caphe audit ./my-service', lines: ['workflow  caphe:default · full scanner stack', 'tasks     sast · sbom · dependencies · secrets · git-workflows', 'evidence  normalized · correlated · worst-first', 'llm       optional · loopback only · hypothesis text', 'bundle    caphe-audit.json · .sarif · .md · sha256 digest'] },
  { id: 'scan', label: 'Scan', command: 'caphe scan ./my-service', lines: ['workflow  baseline-appsec@1.0.0', 'plan      sha256:7a1d… locked', 'tasks     sast · sbom · dependencies · secrets', 'evidence  normalizing scanner observations', 'result    findings persisted with provenance'] },
  { id: 'compile', label: 'Compile', command: 'caphe compile caphe:default', lines: ['security  passed', 'syntax    passed', 'execution not_evaluated', 'accuracy  not_evaluated', 'output    workflow.lock.json'] },
  { id: 'analyze', label: 'Analyze', command: 'caphe ai analyze --finding sha256:… --model local --model-digest sha256:…', lines: ['provider  llama.cpp · loopback only', 'contract  infer-security-invariant/v1', 'output    schema-valid hypothesis', 'status    hypothesized · verification required'] },
  { id: 'report', label: 'Report', command: 'caphe report --format sarif --output caphe.sarif', lines: ['format    SARIF 2.1.0', 'source    persisted scanner observations', 'output    caphe.sarif'] }
];
---
<section class="terminal" aria-label="Illustrative Caphe command walkthrough" data-terminal>
  <div class="titlebar"><span></span><span></span><span></span><div><SquareTerminal size={15}/> caphe — local</div><em>illustrative walkthrough</em></div>
  <div class="tabs" role="tablist" aria-label="Command examples">
    {demos.map((demo, index) => <button role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${demo.id}`} id={`tab-${demo.id}`} data-demo={demo.id}>{demo.label}</button>)}
  </div>
  {demos.map((demo, index) => (
    <div class="panel" id={`panel-${demo.id}`} role="tabpanel" aria-labelledby={`tab-${demo.id}`} hidden={index !== 0} data-panel={demo.id}>
      <div class="command"><span aria-hidden="true">$</span><code>{demo.command}</code><button data-copy={demo.command} aria-label={`Copy ${demo.label} command`}><Copy class="copy" size={16}/><Check class="check" size={16}/></button></div>
      <div class="output" aria-live="polite">{demo.lines.map((line, i) => <p style={`--delay:${i * 90}ms`}><span>{line.split(/\s+/)[0]}</span>{line.slice(line.indexOf(' ') + 1)}</p>)}</div>
    </div>
  ))}
  <p class="note">Commands are implemented; output is human-readable by default and available as stable JSON with <code>--json</code>. Abbreviated output is explanatory, not a benchmark or recorded scan.</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-terminal]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const activate = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
      panels.forEach((panel) => panel.hidden = panel.dataset.panel !== tab.dataset.demo);
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const delta = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(index + delta + tabs.length) % tabs.length];
        next.focus(); activate(next);
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.dataset.copied = 'true';
      setTimeout(() => delete button.dataset.copied, 1500);
    }));
  }
</script>

<style>
  .terminal { overflow: hidden; border: 1px solid #32404a; border-radius: 1rem; background: #0a0e11; color: #e9ece8; box-shadow: 0 30px 90px #0008; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .titlebar { display: flex; align-items: center; gap: .45rem; min-height: 3rem; border-bottom: 1px solid #253038; background: #141a1f; padding: 0 1rem; }
  .titlebar > span { width: .7rem; height: .7rem; border-radius: 50%; background: #43505a; }
  .titlebar > span:first-child { background: #ce6e61; } .titlebar > span:nth-child(2) { background: #d6a56b; } .titlebar > span:nth-child(3) { background: #76c7b7; }
  .titlebar div { display: flex; align-items: center; gap: .45rem; margin-left: .4rem; color: #9ea9ae; font-size: .72rem; }
  .titlebar em { margin-left: auto; color: #7f8b91; font: 500 .65rem ui-sans-serif, sans-serif; }
  .tabs { display: flex; overflow-x: auto; border-bottom: 1px solid #253038; background: #101519; padding: .4rem .6rem 0; }
  .tabs button { min-width: 5.2rem; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #89969c; padding: .65rem .8rem; font: 650 .72rem ui-monospace, monospace; cursor: pointer; }
  .tabs button[aria-selected='true'] { border-color: #d6a56b; color: #f2f0ea; }
  .panel { min-height: 18rem; padding: 1.35rem; }
  .command { display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: .65rem; color: #f2f0ea; }
  .command > span { color: #76c7b7; }
  code { overflow-wrap: anywhere; font-size: clamp(.7rem, 1.6vw, .82rem); }
  .command button { border: 0; background: transparent; color: #89969c; cursor: pointer; }
  .check { display: none; color: #76c7b7; } .command button[data-copied='true'] .copy { display: none; } .command button[data-copied='true'] .check { display: block; }
  .output { margin-top: 1.4rem; color: #9ea9ae; font-size: clamp(.69rem, 1.6vw, .79rem); }
  .output p { display: grid; grid-template-columns: 6.7rem 1fr; gap: .8rem; margin: .65rem 0; opacity: 0; animation: reveal .35s ease forwards; animation-delay: var(--delay); }
  .output span { color: #d6a56b; }
  .note { margin: 0; border-top: 1px solid #253038; color: #7f8b91; padding: .75rem 1.35rem; font: .68rem/1.5 ui-sans-serif, sans-serif; }
  @keyframes reveal { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @media (max-width: 520px) { .titlebar em { display: none; } .panel { min-height: 20rem; padding: 1rem; } .output p { grid-template-columns: 1fr; gap: .15rem; } }
  @media (prefers-reduced-motion: reduce) { .output p { opacity: 1; } }
</style>
