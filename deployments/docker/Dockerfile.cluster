FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/caphe ./cmd/caphe

FROM alpine:3.22 AS tools
RUN apk add --no-cache bash ca-certificates curl tar
COPY scripts/install-tools.sh /tmp/install-tools.sh
RUN bash /tmp/install-tools.sh --bin-dir /opt/caphe/bin --tools poutine,syft,grype,gitleaks

FROM alpine:3.22
RUN apk add --no-cache ca-certificates git && addgroup -g 65532 caphe && adduser -D -H -u 65532 -G caphe caphe && mkdir -p /var/lib/caphe/cluster && chown -R caphe:caphe /var/lib/caphe
COPY --from=build /out/caphe /usr/local/bin/caphe
COPY --from=tools /opt/caphe/bin/ /opt/caphe/bin/
ENV PATH="/opt/caphe/bin:${PATH}"
USER 65532:65532
VOLUME ["/var/lib/caphe/cluster"]
ENTRYPOINT ["/usr/local/bin/caphe"]
